{
  "Comment": "Reconciliation workflow: parse the bank + ledger CSVs, match them, flag mismatches, finish.",
  "StartAt": "ParseFile",
  "States": {
    "ParseFile": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:000000000000:function:ReconcileParseFile",
      "TimeoutSeconds": 60,
      "Next": "MatchTransactions"
    },
    "MatchTransactions": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:000000000000:function:ReconcileMatchTransactions",
      "TimeoutSeconds": 60,
      "Next": "FlagMismatches"
    },
    "FlagMismatches": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:000000000000:function:ReconcileFlagMismatches",
      "TimeoutSeconds": 60,
      "Next": "Complete"
    },
    "Complete": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:000000000000:function:ReconcileComplete",
      "TimeoutSeconds": 60,
      "End": true
    }
  }
}
